# Copy to local.properties and fill in.
# Path to your Android SDK (the folder that contains platforms/ and build-tools/)
sdk.dir=/home/cschappa/Android/Sdk

# Optional: bake your TMDB key into the build (v3 API key or v4 read access token).
# You can also set it on the TV later from Reel's settings or via adb.
tmdb.key=

# Optional: Trakt app client ID (trakt.tv/oauth/applications; redirect URI https://trakt.tv).
# Needed for the Watchlist / For you rows. Can also be pushed via adb (see README).
# New Trakt apps are PKCE-only and have no secret; leave trakt.client_secret blank unless yours has one.
trakt.client_id=
trakt.client_secret=

# Optional: Google OAuth client for the YouTube subscriptions row. In Google Cloud console,
# enable "YouTube Data API v3", then Credentials -> OAuth client ID -> "TVs and Limited Input devices".
# Can also be pushed via adb (see README).
google.client_id=
google.client_secret=
