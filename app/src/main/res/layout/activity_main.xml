<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="24dp"
    android:paddingEnd="48dp"
    android:paddingBottom="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnMediaType"
            style="@style/Chip"
            android:text="Movies" />

        <TextView
            android:id="@+id/btnSort"
            style="@style/Chip"
            android:contentDescription="Sort order"
            android:text="Popular" />

        <TextView
            android:id="@+id/btnSettings"
            style="@style/Chip"
            android:contentDescription="Settings"
            android:text="⚙" />

        <TextView
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Apps (collapses while browsing the poster grid) -->
    <LinearLayout
        android:id="@+id/appsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <TextView
            style="@style/RowLabel"
            android:text="Apps" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appsRow"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <TextView
        style="@style/RowLabel"
        android:text="Genres" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/genreRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false" />

    <!-- Results -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- clipChildren stays on (default) so rows scrolled off the top don't paint over the chip rows;
             clipToPadding off + padding leaves room for the focus scale on the edge rows. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="10dp"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:maxWidth="640dp"
                android:textColor="@color/text_dim"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
