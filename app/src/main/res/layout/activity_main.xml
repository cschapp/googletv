<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <!-- Everything above the poster grid. It scrolls so the focused row is always on screen,
         since big subscription thumbnails can push the genres below the fold. The page margins
         live inside it so a focused card's grow animation isn't clipped at the edges. -->
    <dev.craig.reel.FocusSafeScrollView
        android:id="@+id/topScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="24dp"
        android:paddingEnd="48dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/greeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSearch"
            style="@style/Chip"
            android:contentDescription="Search movies and shows"
            android:text="🔍 Search" />

        <TextView
            android:id="@+id/btnMediaType"
            style="@style/Chip"
            android:text="Movies" />

        <TextView
            android:id="@+id/btnSort"
            style="@style/Chip"
            android:contentDescription="Sort order"
            android:text="Popular" />

        <TextView
            android:id="@+id/btnSettings"
            style="@style/Chip"
            android:contentDescription="Settings"
            android:text="⚙" />

        <TextView
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- A movie line that fades to a new one every so often; full width so long ones fit -->
    <TextView
        android:id="@+id/quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/text_dim"
        android:textSize="14sp"
        android:textStyle="italic" />

    <!-- Apps (collapses while browsing the poster grid) -->
    <LinearLayout
        android:id="@+id/appsSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <TextView
            style="@style/RowLabel"
            android:text="Apps" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appsRow"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <!-- New uploads from your YouTube subscriptions; ⚙ at its left end hides or resizes it -->
        <TextView
            android:id="@+id/youtubeLabel"
            style="@style/RowLabel"
            android:text="YouTube" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/youtubeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <TextView
        style="@style/RowLabel"
        android:text="Genres" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/genreRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false" />
    </LinearLayout>
    </dev.craig.reel.FocusSafeScrollView>

    <!-- Results -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="48dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- clipChildren stays on (default) so rows scrolled off the top don't paint over the chip rows;
             clipToPadding off + padding leaves room for the focus scale on the edge rows. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="10dp"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:maxWidth="640dp"
                android:textColor="@color/text_dim"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
